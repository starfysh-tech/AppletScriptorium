# AppletScriptorium Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# LM Studio Configuration (Required - Primary LLM Backend)
# Download from https://lmstudio.ai, load a model, and start the server (CMD+R)
LMSTUDIO_BASE_URL=http://localhost:1234        # LM Studio server URL (typically localhost:1234)
LMSTUDIO_TIMEOUT=180.0                         # Request timeout in seconds

# The model is NOT pinned: whatever LM Studio has loaded is used. These are
# preferences, highest first — the first one that is loaded wins; if none is
# loaded, the first that is downloaded gets loaded on demand. Names must match
# `lms ls` exactly. This line is also the built-in default; set it empty
# (LMSTUDIO_PREFERRED_MODELS=) to express no preference at all.
LMSTUDIO_PREFERRED_MODELS=qwen/qwen3.5-9b,zai-org/glm-4.6v-flash
LMSTUDIO_REASONING_EFFORT=none                 # none|low|medium|high — "none" is ~20x faster
LMSTUDIO_MAX_TOKENS=2048                       # Completion budget per summary (raise if reasoning is on)
# LMSTUDIO_MODEL=                              # Legacy pin; only used if nothing above resolves

# SMTP Email Delivery (Required - For sending digest emails)
# Gmail users: Use app password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com                       # SMTP server hostname
SMTP_PORT=587                                  # SMTP port (587 for TLS, 465 for SSL)
SMTP_USERNAME=your-email@gmail.com             # SMTP account username
SMTP_PASSWORD=your-app-password-here           # SMTP password (use app password for Gmail)
SMTP_FROM_EMAIL=your-email@gmail.com           # Sender email address

# Digest Recipient (Required - Where to send digests)
ALERT_DIGEST_EMAIL=your-email@example.com      # Default digest recipient email address

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Ollama Fallback Backend (Optional)
# Only used if LM Studio fails AND OLLAMA_ENABLED=true
# Uncomment to enable:
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=qwen3:latest
# OLLAMA_TIMEOUT=120.0

# Article Fetching (Optional)
# JINA_API_KEY=your-jina-api-key               # Jina Reader API for bot-protected sites
# ALERT_HTTP_HEADERS_JSON='{"example.com": {"Cookie": "session=abc"}}'  # Custom headers

# Email Configuration (Optional)
# ALERT_EMAIL_SENDER=sender@example.com        # Override sender (defaults to SMTP_FROM_EMAIL)

# Processing Limits (Optional)
# ALERT_MAX_ARTICLES=10                        # Limit number of articles processed per run
# ALERT_MODEL=qwen3:latest                     # Override model for active backend
